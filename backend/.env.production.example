APP_NAME="AI Codebase Assistant"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["https://your-domain.example"]
DATABASE_URL=postgresql+psycopg://aica:${POSTGRES_PASSWORD}@postgres:5432/aica
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_REPO=5000
AUTH_SECRET_KEY=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=false
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
LLM_API_KEY=REPLACE_ME
LLM_MODEL_NAME=REPLACE_ME
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PREFIX=aica_chunks
OLLAMA_URL=http://ollama:11434
