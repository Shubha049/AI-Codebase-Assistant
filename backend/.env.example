# Copy to .env and adjust. Every name here matches a field in app/config.py
# exactly — if you rename something here, rename it there too, or Settings
# will silently ignore it (extra="ignore").

APP_NAME="AI Codebase Assistant"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# SQLite by default — zero setup. For production:
# DATABASE_URL=postgresql://user:password@localhost:5432/aica
DATABASE_URL=sqlite:///./data/aica.db

MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_REPO=5000

# =============================================================================
# Embedding & Vector Indexing Configuration
# =============================================================================
# Recommended local semantic search provider (free, runs locally on CPU/GPU):
#   pip install sentence-transformers
#   EMBEDDING_PROVIDER=local
#   EMBEDDING_MODEL=all-MiniLM-L6-v2
#
# Cloud OpenAI provider:
#   EMBEDDING_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   EMBEDDING_MODEL=text-embedding-3-small
#
# Local Ollama provider:
#   EMBEDDING_PROVIDER=ollama
#   OLLAMA_URL=http://localhost:11434
#   EMBEDDING_MODEL=nomic-embed-text
#
# Offline CI/Test fallback only (deterministic n-gram hash vectors, zero downloads):
#   EMBEDDING_PROVIDER=mock
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3

# Persistent Vector Store
# Local filesystem storage: data/qdrant
# Standalone Docker Qdrant: http://localhost:6333
# Ephemeral test memory: :memory:
QDRANT_URL=data/qdrant
QDRANT_COLLECTION_PREFIX=aica_chunks

# =============================================================================
# LLM Q&A Copilot Configuration
# =============================================================================
# Recommended free local model (runs fast on CPU via Ollama):
#   ollama pull llama3.2:1b
#   LLM_PROVIDER=ollama
#   LLM_MODEL_NAME=llama3.2:1b
#   OLLAMA_URL=http://localhost:11434
#
# Cloud OpenAI provider:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   LLM_MODEL_NAME=gpt-4o-mini
#
# Offline CI/Test fallback only (deterministic offline mock):
#   LLM_PROVIDER=mock
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL_NAME=llama3.2:1b
LLM_TIMEOUT_SECONDS=180
LLM_BASE_URL=

